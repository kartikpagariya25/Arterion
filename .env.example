# Copy to .env and adjust as needed. ml-inference reads these via os.environ
# (sensible defaults are used when a variable is unset, so .env is optional
# for local development).

# Base URL the frontend (js/common.js) targets for all API calls.
API_BASE=http://127.0.0.1:8000

# Secret used to sign auth JWTs — set a long random value before deploying.
JWT_SECRET=change-me-before-deploying

# SQLite file location (relative to ml-inference/app).
DATABASE_PATH=app/cardiosense.db

# Where uploaded scans/images are stored, served at /static_uploads.
UPLOAD_DIR=app/static_uploads
